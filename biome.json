{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useButtonType": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useConst": "error",
        "useNodejsImportProtocol": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noStaticOnlyClass": "off",
        "useOptionalChain": "off",
        "noBannedTypes": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTemplateCurlyInString": "off",
        "noGlobalIsNan": "off",
        "noGlobalIsFinite": "off",
        "noAssignInExpressions": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "allowWrongLineComments": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.next",
      "!**/coverage",
      "!**/.tailwind-refactor-cache",
      "!**/.tailwind-refactor",
      "!**/benchmark_log.json",
      "!**/*.min.js",
      "!**/*.min.css",
      "!**/tests/fixtures",
      "!**/scratch"
    ]
  }
}
