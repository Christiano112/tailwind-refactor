{
  "name": "eslint-plugin-tailwind-refactor",
  "version": "0.1.0",
  "type": "module",
  "description": "ESLint plugin for tailwind-refactor static analysis and auto-fixing",
  "author": "Christian Enyia <christianowebdev@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@tailwind-refactor/core": "workspace:*",
    "@tailwind-refactor/parser": "workspace:*",
    "@tailwind-refactor/resolver": "workspace:*",
    "@tailwind-refactor/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "typescript": "^5.7.2"
  }
}
